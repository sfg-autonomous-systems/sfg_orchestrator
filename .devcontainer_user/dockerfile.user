FROM isaac-ros AS sfg-experimental-area

RUN --mount=type=cache,id=apt_cache_devcontainer,target="/var/cache/apt" \
    sudo apt update && sudo apt install -y --no-install-recommends \
        libcanberra-gtk-module \
        libcanberra-gtk3-module \
        ros-${ROS_DISTRO}-rqt-robot-monitor \
        ros-${ROS_DISTRO}-isaac-ros-h264-decoder && \
    sudo apt -y autoremove && sudo apt clean && sudo rm -rf "/var/lib/apt/lists/*"

CMD cd "${REPOSITORY_DIRECTORY}/colcon_ws" && \
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release && \
    source "install/setup.bash" && \
    ros2 launch sfg_experimental_area "experimental_area.launch.py"
