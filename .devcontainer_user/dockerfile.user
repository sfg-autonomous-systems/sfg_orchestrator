FROM sfg-agent-devcontainer AS sfg-experimental-area

WORKDIR ${HOME}/dependencies

# SDL3
RUN sudo apt update && sudo apt install -y --no-install-recommends \
        build-essential \
        git\
        make \
        pkg-config \
        cmake \
        ninja-build \
        gnome-desktop-testing \
        libasound2-dev \
        libpulse-dev \
        libaudio-dev \
        libfribidi-dev \
        libjack-dev \
        libsndio-dev \
        libx11-dev \
        libxext-dev \
        libxrandr-dev \ 
        libxcursor-dev \
        libxfixes-dev \
        libxi-dev \
        libxss-dev \
        libxtst-dev \
        libxkbcommon-dev \
        libdrm-dev \
        libgbm-dev \
        libgl1-mesa-dev \
        libgles2-mesa-dev \
        libegl1-mesa-dev \
        libdbus-1-dev \
        libibus-1.0-dev \
        libudev-dev \
        libthai-dev \
        libpipewire-0.3-dev \
        libwayland-dev \
        libdecor-0-dev \
        liburing-dev \ 
        zenity && \
    sudo apt -y autoremove && sudo apt clean && sudo rm -rf "/var/lib/apt/lists/"* && \
    \
    git clone -b "release-3.4.0" --depth 1 "https://github.com/libsdl-org/SDL.git" && \
    cd "SDL" && \
    cmake -B "build" \
        -DCMAKE_BUILD_TYPE=Release && \
    cmake --build "build" -j$(nproc) && \
    sudo cmake --install "build" && sudo ldconfig

# RViz and Rerun SDK
RUN sudo apt update && sudo apt install -y --no-install-recommends \
        ros-${ROS_DISTRO}-rviz2 \
        libgtk-3-dev \
        libxkbcommon-x11-0 \
        vulkan-tools && \
    sudo apt -y autoremove && sudo apt clean && sudo rm -rf "/var/lib/apt/lists/"* && \
    \
    pip install \
        rerun-sdk==0.25.1

RUN sudo rm -rf "${HOME}/dependencies"

WORKDIR ${WORKSPACE_DIRECTORY}

CMD "${REPOSITORY_DIRECTORY}/.devcontainer/scripts/post_start_command" && \
    source "/opt/ros/${ROS_DISTRO}/setup.bash" && \
    cd "${REPOSITORY_DIRECTORY}/colcon_ws" && \
    source "install/setup.bash" && \
    ros2 launch sfg_experimental_area_bringup "bringup.launch.py"
